{
  "manifest_version": 3,
  "name": "Draft Omen for Moxgate",
  "version": "0.1.0",
  "description": "Sends Moxgate draft picks to Draft Omen running on this computer.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.moxgate.com/*"],
      "js": ["dom_reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
