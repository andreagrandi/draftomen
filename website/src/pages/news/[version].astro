---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { version: entry.data.version },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { version, date } = entry.data;
const { Content } = await render(entry);
const dateText = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout
  title={`Draft Omen ${version} release notes — Draft Omen`}
  description={`What changed in Draft Omen ${version}, released on ${dateText}.`}
  canonicalPath={`/news/${version}/`}
>
  <section class="page-intro">
    <div class="shell">
      <p class="eyebrow">Release notes</p>
      <h1>Draft Omen {version}</h1>
      <p class="intro-lede">
        Released on <time datetime={date.toISOString().slice(0, 10)}>{dateText}</time>.
      </p>
      <p class="release-links">
        <a class="text-link" href="/news/"><span aria-hidden="true">←</span> All releases</a>
        <a
          class="text-link"
          href={`https://github.com/andreagrandi/draftomen/releases/tag/v${version}`}
        >
          View on GitHub <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>

  <section class="section pt-0" aria-label="Release notes">
    <div class="shell">
      <div class="content-stack release-prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
