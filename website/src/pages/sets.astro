---
import BaseLayout from '../layouts/BaseLayout.astro';
import setsManifest from '../../public/sets/manifest.json';

type SetEntry = {
  name: string;
  card_data: { url: string } | null;
  profiles: Record<string, { maturity: string }>;
  augmented: object | null;
};

const sets = Object.entries(setsManifest.sets as Record<string, SetEntry>)
  .map(([code, entry]) => ({
    code: code.toUpperCase(),
    name: entry.name,
    // A set counts as supported only with card data and 17Lands ratings for at least one format.
    supported:
      entry.card_data !== null
      && Object.values(entry.profiles).some((profile) => profile.maturity !== 'metadata-only'),
    augmented: entry.augmented !== null,
  }))
  .sort((left, right) => left.name.localeCompare(right.name));

const supportedSets = sets.filter((set) => set.supported);
const unratedSets = sets.filter((set) => !set.supported);
---

<BaseLayout
  title="Supported sets — Draft Omen"
  description="The sets Draft Omen supports with 17Lands ratings, and the sets it knows without ratings yet."
  canonicalPath="/sets/"
>
  <section class="page-intro">
    <div class="shell">
      <p class="eyebrow">Supported sets</p>
      <h1>Which sets Draft Omen supports.</h1>
      <p class="intro-lede">
        Draft Omen supports {supportedSets.length} sets with 17Lands ratings.
        Sets marked with an augmented model also get pick scores adjusted by a
        model trained on public 17Lands drafts.
      </p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="supported-heading">
    <div class="shell">
      <h2 id="supported-heading" class="sets-heading">Supported sets</h2>
      <div class="sets-table-wrap">
        <table class="sets-table">
          <thead>
            <tr>
              <th scope="col">Set</th>
              <th scope="col" class="sets-mark-column">Augmented model</th>
            </tr>
          </thead>
          <tbody>
            {supportedSets.map((set) => (
              <tr id={set.code.toLowerCase()}>
                <th scope="row">
                  <span class="set-name">{set.name}</span>
                  <span class="set-code">{set.code}</span>
                </th>
                <td class="sets-mark-column">
                  {set.augmented && <span role="img" aria-label="Augmented model available">✅</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="unrated-heading">
    <div class="shell">
      <h2 id="unrated-heading" class="sets-heading">Sets without 17Lands data</h2>
      <p class="sets-note">
        Draft Omen recognises the cards in these sets but has no 17Lands
        ratings for them yet, so their picks are scored without ratings.
      </p>
      <ul class="unrated-sets">
        {unratedSets.map((set) => (
          <li id={set.code.toLowerCase()}>
            {set.name} <span class="set-code">{set.code}</span>
          </li>
        ))}
      </ul>
      <p class="sets-note">
        Mocked Draft also needs the set in your local Draftmancer checkout.
      </p>
    </div>
  </section>
</BaseLayout>
